# NetCore TAC ETA API configuration. Copy to .env (git-ignored) and adjust.
# Invalid values stop the API at startup with a clear message.

# Title shown in OpenAPI / Swagger UI
APP_NAME=NetCore TAC ETA API
# development | production
APP_ENV=development
# Bind address for uvicorn (Docker: fixed to 0.0.0.0 inside the container)
HOST=0.0.0.0
# Bind port (Docker Compose: host port published to container port 8000)
PORT=8000
# critical | error | warning | info | debug | trace
LOG_LEVEL=info
# Trained pipeline (joblib), relative to the working directory
MODEL_PATH=models/eta_model.joblib
# Model metadata (JSON) written by scripts/train_model.py
MODEL_METADATA_PATH=models/eta_model.json
# Requests allowed per client IP per window
RATE_LIMIT_REQUESTS=100
# Window length in seconds
RATE_LIMIT_WINDOW_SECONDS=60
# Block length in seconds after the limit is exceeded
RATE_LIMIT_BLOCK_SECONDS=30
# true only behind a trusted reverse proxy: use the first X-Forwarded-For address
TRUST_PROXY_HEADERS=false
# false disables /docs, /redoc and /openapi.json
DOCS_ENABLED=true
